{
  "name": "@particle-academy/fancy-passkeys-ui",
  "version": "0.2.0",
  "description": "React surfaces for passkey (WebAuthn) sign-in and passkey management, plus a React-free browser-ceremony subpath. Controlled, JSON-serializable, agent-bridgeable — and deliberately not agent-completable.",
  "keywords": [
    "passkey",
    "passkeys",
    "webauthn",
    "react",
    "login",
    "authentication",
    "human-plus",
    "agent",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-passkeys-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-passkeys-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-passkeys-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/react-fancy": ">=4.9.0",
    "@simplewebauthn/browser": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@particle-academy/react-fancy": "^4.17.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=22"
  }
}
